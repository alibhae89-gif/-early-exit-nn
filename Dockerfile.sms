FROM python:3.12-slim
WORKDIR /app
ENV HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 PYTHONUNBUFFERED=1
RUN pip install --no-cache-dir torch==2.14.1 --index-url https://download.pytorch.org/whl/cpu
COPY requirements_sms.txt .
RUN pip install --no-cache-dir -r requirements_sms.txt
COPY sms_app.py sms.html results_sms.json stage1.joblib ./
COPY stage2 ./stage2
RUN chmod -R a+rX /app
RUN useradd -m appuser
USER appuser
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1
CMD ["uvicorn", "sms_app:app", "--host", "0.0.0.0", "--port", "8000"]
